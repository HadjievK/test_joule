                            },
                            "currency": {
                              "type": "string"
                            },
                            "payFrequency": {
                              "type": "string"
                            },
                            "compRatio": {
                              "type": "number"
                            },
                            "lastModifiedDate": {
                              "type": "string",
                              "format": "date-time"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "description": "List of compensation records (HTTP 200)"
              }
            ]
          }
        }
      }
    },
    {
      "name": "getCompensationInformation",
      "title": "getCompensationInformation",
      "description": "Retrieve compensation information for a specific employee on a given effective date",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
