{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "Employee Cost Assignment",
    "description": "You can use this API to define the organizational assignment and additional cost assignment of the cost center, fund, grant, functional area, budget period, and funds center for an employee. This API is implemented based on OData version 2 specification.\n\n You can find your company's API server in [List of API Servers in SAP SuccessFactors.](https://help.sap.com/viewer/d599f15995d348a1b45ba5603e2aba9b/LATEST/en-US/af2b8d5437494b12be88fe374eba75b6.html)"
  },
  "paths": {
    "/EmpCostAssignment": {
      "get": {
        "summary": "Get all Employee Cost Assignments",
        "description": "You can use the following request to get all employee cost assignments. <br>For further details, refer to the SAP Help Portal documentation [OData API: EmpCostAssignment](https://help.sap.com/docs/SAP_SUCCESSFACTORS_PLATFORM/b2b06831c2cb4d5facd1dfde49a7aab5/a60fb8ac528044f191bc9735ac174c72.html)",
        "tags": [
          "EmpCostAssignment"
        ],
        "parameters": [
          {
            "name": "$top",
            "in": "query",
            "required": false,
            "description": "Show only the first n items, see [OData Paging - Top](http://docs.oasis-open.org/odata/odata/v4.0/odata-v4.0-part1-protocol.html#_Toc445374630)",
            "schema": {
              "type": "integer",
              "default": 20
            }
          },
          {
            "name": "$skip",
            "in": "query",
            "required": false,
            "description": "Skip the first n items, see [OData Paging - Skip](http://docs.oasis-open.org/odata/odata/v4.0/odata-v4.0-part1-protocol.html#_Toc445374631)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "$filter",
            "in": "query",
            "required": false,
            "description": "Filter items by property values, see [OData Filtering](http://docs.oasis-open.org/odata/odata/v4.0/odata-v4.0-part1-protocol.html#_Toc445374625)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "$count",
            "in": "query",
            "required": false,
            "description": "Include count of items, see [OData Count](http://docs.oasis-open.org/odata/odata/v4.0/odata-v4.0-part1-protocol.html#_Toc445374632)",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "$orderby",
            "in": "query",
            "required": false,
            "description": "Order items by property values, see [Sorting](http://docs.oasis-open.org/odata/odata/v4.01/odata-v4.01-part1-protocol.html#sec_SystemQueryOptionorderby)",
            "schema": {
              "type": "array"
            }
          },
          {
            "name": "$select",
            "in": "query",
            "required": false,
            "description": "Select properties to be returned, see [Select](http://docs.oasis-open.org/odata/odata/v4.01/odata-v4.01-part1-protocol.html#sec_SystemQueryOptionselect)",
            "schema": {
              "type": "array"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Retrieved EmpCostAssignments.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Wrapper",
                  "properties": {
                    "d": {
                      "type": "object",
                      "title": "Collection of EmpCostAssignment",
                      "properties": {
                        "results": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/SFOData.EmpCostAssignment"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - authorization information is missing or invalid."
          }
        }
      },
      "post": {
        "summary": "Create new Employee Cost Assignment",
        "description": "You can use the following request to create a new employee cost assignment. <br>For further details, refer to the SAP Help Portal documentation [OData API: EmpCostAssignment](https://help.sap.com/docs/SAP_SUCCESSFACTORS_PLATFORM/b2b06831c2cb4d5facd1dfde49a7aab5/a60fb8ac528044f191bc9735ac174c72.html)",
