    "/EmpCostAssignment(effectiveStartDate=datetime'{effectiveStartDate}',worker='{worker}')": {
      "get": {
        "summary": "Get Employee Cost Assignment by key",
        "description": "You can use the following request to get employee cost assignment by effective start date and worker. <br>For further details, refer to the SAP Help Portal documentation [OData API: EmpCostAssignment](https://help.sap.com/docs/SAP_SUCCESSFACTORS_PLATFORM/b2b06831c2cb4d5facd1dfde49a7aab5/a60fb8ac528044f191bc9735ac174c72.html)",
        "tags": [
          "EmpCostAssignment"
        ],
        "parameters": [
          {
            "name": "effectiveStartDate",
            "in": "path",
            "required": true,
            "description": "key: effectiveStartDate, format: <YYYY-MM-DD>T<HH:MM:SS>  <br>\nExample: ```2021-01-01T00:00:00```",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "worker",
            "in": "path",
            "required": true,
            "description": "key: worker, format: worker <br>\nExample: ```string```",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "$select",
            "in": "query",
            "required": false,
            "description": "Select properties to be returned, see [Select](http://docs.oasis-open.org/odata/odata/v4.01/odata-v4.01-part1-protocol.html#sec_SystemQueryOptionselect)",
            "schema": {
              "type": "array"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Retrieved EmpCostAssignment.",
            "content": {
              "application/json": {
                "schema": {
                  "title": "EmpCostAssignment",
                  "type": "object",
                  "properties": {
                    "d": {
                      "$ref": "#/components/schemas/SFOData.EmpCostAssignment"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - authorization information is missing or invalid."
          },
          "404": {
            "description": "Not found - EmpCostAssignment is not found with the given key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/odata.error"
                }
              }
            }
          }
        }
      }
    },
