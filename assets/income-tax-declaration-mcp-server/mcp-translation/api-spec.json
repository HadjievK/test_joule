{
  "openapi": "3.0.0",
  "info": {
    "title": "Income Tax Declaration",
    "version": "1.0.0",
    "description": "API for accessing SAP SuccessFactors Income Tax Declaration records for payroll compliance"
  },
  "servers": [{"url": "/odata/v2"}],
  "paths": {
    "/IncomeTaxDeclaration": {
      "get": {
        "operationId": "listIncomeTaxDeclarations",
        "summary": "List income tax declarations",
        "description": "Retrieve income tax declarations for employees including exemptions and investments",
        "parameters": [
          {"name": "$top", "in": "query", "schema": {"type": "integer", "maximum": 100}},
          {"name": "$skip", "in": "query", "schema": {"type": "integer"}},
          {"name": "$filter", "in": "query", "schema": {"type": "string"}},
          {"name": "$select", "in": "query", "schema": {"type": "string"}},
          {"name": "$orderby", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "List of tax declarations", "content": {"application/json": {"schema": {"type": "object", "properties": {"d": {"type": "object", "properties": {"results": {"type": "array", "items": {"$ref": "#/components/schemas/IncomeTaxDeclaration"}}}}}}}}}
        }
      }
    },
    "/IncomeTaxDeclaration('{externalCode}')": {
      "get": {
        "operationId": "getIncomeTaxDeclaration",
        "summary": "Get a specific income tax declaration",
        "description": "Retrieve a specific income tax declaration by external code",
        "parameters": [
          {"name": "externalCode", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Income tax declaration", "content": {"application/json": {"schema": {"type": "object"}}}}
        }
      }
    },
    "/DeclarationType": {
      "get": {
        "operationId": "listDeclarationTypes",
        "summary": "List declaration types",
        "description": "Retrieve all available income tax declaration types",
        "parameters": [
          {"name": "$top", "in": "query", "schema": {"type": "integer", "maximum": 100}},
          {"name": "$filter", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Declaration types", "content": {"application/json": {"schema": {"type": "object"}}}}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IncomeTaxDeclaration": {
        "type": "object",
        "properties": {
          "externalCode": {"type": "string"},
          "userId": {"type": "string"},
          "fiscalYear": {"type": "string"},
          "declarationType": {"type": "string"},
          "status": {"type": "string"},
          "totalExemption": {"type": "number"},
          "totalInvestment": {"type": "number"},
          "currency": {"type": "string"},
          "submissionDate": {"type": "string", "format": "date"},
          "approvalStatus": {"type": "string"}
        }
      }
    }
  }
}
