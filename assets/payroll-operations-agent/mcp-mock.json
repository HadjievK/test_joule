{
  "servers": {
    "employee_central_payroll": {
      "tools": {
        "listPayrollRunResults": {
          "description": "List employee payroll run results from SAP SuccessFactors Employee Central Payroll",
          "input_schema": {
            "type": "object",
            "properties": {
              "$top": {"type": "integer", "description": "Maximum number of records (max 100)"},
              "$filter": {"type": "string", "description": "OData filter expression"},
              "$select": {"type": "string", "description": "Fields to return"}
            }
          },
          "mock_response": {
            "d": {
              "results": [
                {
                  "externalCode": "PR-2024-01-EMP001",
                  "employeeId": "EMP001",
                  "payrollArea": "US",
                  "payPeriod": "2024-01",
                  "runType": "regular",
                  "status": "completed",
                  "grossPay": 8500.00,
                  "netPay": 6200.00,
                  "currency": "USD"
                },
                {
                  "externalCode": "PR-2024-01-EMP002",
                  "employeeId": "EMP002",
                  "payrollArea": "US",
                  "payPeriod": "2024-01",
                  "runType": "regular",
                  "status": "completed",
                  "grossPay": 7200.00,
                  "netPay": 5100.00,
                  "currency": "USD"
                },
                {
                  "externalCode": "PR-2024-01-EMP003",
                  "employeeId": "EMP003",
                  "payrollArea": "DE",
                  "payPeriod": "2024-01",
                  "runType": "regular",
                  "status": "pending",
                  "grossPay": 5800.00,
                  "netPay": 3900.00,
                  "currency": "EUR"
                }
              ]
            }
          }
        },
        "getPayrollRunResult": {
          "description": "Get a specific employee payroll run result by external code",
          "input_schema": {
            "type": "object",
            "required": ["externalCode"],
            "properties": {
              "externalCode": {"type": "string", "description": "External code of the payroll run result"}
            }
          },
          "mock_response": {
            "d": {
              "externalCode": "PR-2024-01-EMP001",
              "employeeId": "EMP001",
              "payrollArea": "US",
              "payPeriod": "2024-01",
              "runType": "regular",
              "status": "completed",
              "grossPay": 8500.00,
              "netPay": 6200.00,
              "currency": "USD"
            }
          }
        },
        "listPayrollRunResultItems": {
          "description": "List payroll run result line items (wage types, deductions)",
          "input_schema": {
            "type": "object",
            "properties": {
              "$top": {"type": "integer", "description": "Maximum number of records (max 100)"},
              "$filter": {"type": "string", "description": "OData filter expression"}
            }
          },
          "mock_response": {
            "d": {
              "results": [
                {
                  "wageType": "1000",
                  "description": "Basic Salary",
                  "amount": 8500.00,
                  "currency": "USD"
                },
                {
                  "wageType": "2000",
                  "description": "Federal Tax",
                  "amount": -1800.00,
                  "currency": "USD"
                }
              ]
            }
          }
        }
      }
    },
