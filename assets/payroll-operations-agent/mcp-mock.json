{
  "servers": {
    "sf_payroll": {
      "tools": {
        "get_sf_payroll_run_status": {
          "description": "Retrieves SuccessFactors payroll run status and results",
          "input_schema": {
            "type": "object",
            "properties": {
              "externalCode": {"type": "string", "description": "Payroll run external code"},
              "mdfSystemEffectiveStartDate": {"type": "string", "description": "Effective start date (YYYY-MM-DD)"},
              "top": {"type": "integer", "description": "Maximum number of results"}
            }
          },
          "mock_response": {
            "value": [
              {
                "externalCode": "RUN-2024-01",
                "mdfSystemEffectiveStartDate": "2024-01-01",
                "payrollPeriod": "2024-01",
                "status": "Completed",
                "employeeCount": 150,
                "grossPayroll": 750000.00,
                "totalDeductions": 187500.00,
                "netPayroll": 562500.00
              }
            ]
          }
        },
        "get_sf_payroll_run_items": {
          "description": "Retrieves SuccessFactors payroll run result line items",
          "input_schema": {
            "type": "object",
            "properties": {
              "EmployeePayrollRunResults_externalCode": {"type": "string", "description": "Parent run external code"},
              "top": {"type": "integer", "description": "Maximum number of results"}
            }
          },
          "mock_response": {
            "value": [
              {"externalCode": "ITEM-001", "employeeId": "EMP001", "wageType": "1000", "amount": 5000.00, "currency": "USD"},
              {"externalCode": "ITEM-002", "employeeId": "EMP002", "wageType": "1000", "amount": 4500.00, "currency": "USD"}
            ]
          }
        },
        "get_time_sheets": {
          "description": "Retrieves employee time sheet list",
          "input_schema": {
            "type": "object",
            "properties": {
              "externalCode": {"type": "string", "description": "Employee external code"},
              "top": {"type": "integer", "description": "Maximum number of results"}
            }
          },
          "mock_response": {
            "value": [
              {"externalCode": "TS-EMP001-2024-01", "employeeId": "EMP001", "periodStart": "2024-01-01", "periodEnd": "2024-01-31", "status": "Approved", "totalHours": 160},
              {"externalCode": "TS-EMP002-2024-01", "employeeId": "EMP002", "periodStart": "2024-01-01", "periodEnd": "2024-01-31", "status": "Pending", "totalHours": 0}
            ]
          }
        },
        "get_time_sheet_entries": {
          "description": "Retrieves individual time entries for a given time sheet",
          "input_schema": {
            "type": "object",
            "properties": {
              "EmployeeTimeSheet_externalCode": {"type": "string", "description": "Parent time sheet external code"},
              "top": {"type": "integer", "description": "Maximum number of results"}
            }
          },
          "mock_response": {
            "value": [
              {"externalCode": "ENTRY-001", "date": "2024-01-15", "hours": 8, "timeType": "REGULAR"},
              {"externalCode": "ENTRY-002", "date": "2024-01-16", "hours": 8, "timeType": "REGULAR"}
            ]
          }
        },
        "get_time_valuation_results": {
          "description": "Retrieves calculated time values and allowances",
          "input_schema": {
            "type": "object",
            "properties": {
              "EmployeeTimeSheet_externalCode": {"type": "string", "description": "Parent time sheet external code"},
              "top": {"type": "integer", "description": "Maximum number of results"}
            }
          },
          "mock_response": {
            "value": [
              {"externalCode": "TVR-001", "valuationType": "REGULAR_HOURS", "quantity": 160, "unit": "HOURS"}
            ]
          }
        },
        "update_time_sheet_entry": {
          "description": "Updates an existing time sheet entry",
          "input_schema": {
            "type": "object",
            "properties": {
              "EmployeeTimeSheet_externalCode": {"type": "string", "description": "Parent time sheet external code"},
              "externalCode": {"type": "string", "description": "Entry external code"},
              "hours": {"type": "number", "description": "Updated hours"},
              "timeType": {"type": "string", "description": "Time type code"}
            },
            "required": ["EmployeeTimeSheet_externalCode", "externalCode"]
          },
          "mock_response": {
            "externalCode": "ENTRY-001",
            "hours": 8,
            "timeType": "REGULAR",
            "lastModifiedDateTime": "2024-01-16T10:00:00Z",
            "status": "Updated"
          }
        },
        "create_time_sheet_entry": {
          "description": "Creates a new time sheet entry",
          "input_schema": {
            "type": "object",
            "properties": {
              "EmployeeTimeSheet_externalCode": {"type": "string", "description": "Parent time sheet external code"},
              "date": {"type": "string", "description": "Date of the entry (YYYY-MM-DD)"},
              "hours": {"type": "number", "description": "Hours worked"},
              "timeType": {"type": "string", "description": "Time type code"}
            },
            "required": ["EmployeeTimeSheet_externalCode", "date", "hours"]
          },
          "mock_response": {
            "externalCode": "ENTRY-NEW-001",
            "date": "2024-01-17",
            "hours": 8,
            "timeType": "REGULAR",
            "createdDateTime": "2024-01-17T08:00:00Z",
            "status": "Created"
          }
        },
        "get_compensation_info": {
          "description": "Retrieves employee compensation and reimbursement records",
          "input_schema": {
            "type": "object",
            "properties": {
              "employeeId": {"type": "string", "description": "Employee ID"},
              "top": {"type": "integer", "description": "Maximum number of results"}
            }
          },
          "mock_response": {
            "value": [
              {"employeeId": "EMP001", "baseSalary": 60000.00, "currency": "USD", "payGrade": "G5", "effectiveDate": "2024-01-01"}
            ]
          }
        },
        "get_cost_assignments": {
          "description": "Retrieves employee cost centre allocations",
          "input_schema": {
            "type": "object",
            "properties": {
              "worker": {"type": "string", "description": "Employee ID"},
              "effectiveStartDate": {"type": "string", "description": "Effective start date"},
              "top": {"type": "integer", "description": "Maximum number of results"}
            }
          },
          "mock_response": {
            "value": [
              {"worker": "EMP001", "costCenter": "CC-100", "percentage": 100, "effectiveStartDate": "2024-01-01"}
            ]
          }
        },
        "upsert_cost_assignment": {
          "description": "Creates or updates an employee cost assignment",
          "input_schema": {
            "type": "object",
            "properties": {
              "worker": {"type": "string", "description": "Employee ID"},
              "costCenter": {"type": "string", "description": "Cost centre code"},
              "percentage": {"type": "number", "description": "Allocation percentage"},
              "effectiveStartDate": {"type": "string", "description": "Effective start date"}
            },
            "required": ["worker", "costCenter", "percentage"]
          },
          "mock_response": {
            "worker": "EMP001",
            "costCenter": "CC-200",
            "percentage": 100,
            "effectiveStartDate": "2024-02-01",
            "status": "Upserted"
          }
        },
        "get_income_tax_declarations": {
          "description": "Retrieves income tax declaration records",
          "input_schema": {
            "type": "object",
            "properties": {
              "employeeId": {"type": "string", "description": "Employee ID"},
              "taxYear": {"type": "string", "description": "Tax year (YYYY)"},
              "top": {"type": "integer", "description": "Maximum number of results"}
            }
          },
          "mock_response": {
            "value": [
              {"employeeId": "EMP001", "taxYear": "2024", "declaredIncome": 60000.00, "taxWithheld": 12000.00, "status": "Filed", "filingDate": "2024-04-15"}
            ]
          }
        },
        "get_global_benefits": {
          "description": "Retrieves employee global benefits and deductions",
          "input_schema": {
            "type": "object",
            "properties": {
              "employeeId": {"type": "string", "description": "Employee ID"},
              "benefitType": {"type": "string", "description": "Benefit type filter"},
              "top": {"type": "integer", "description": "Maximum number of results"}
            }
          },
          "mock_response": {
            "value": [
              {"employeeId": "EMP001", "benefitType": "HEALTH_INSURANCE", "provider": "BlueCross", "coverageAmount": 500.00, "employeeDeduction": 150.00, "status": "Active"}
            ]
          }
        },
        "trigger_sf_payroll_run": {
          "description": "Initiates a SuccessFactors payroll run — requires human confirmation",
          "input_schema": {
            "type": "object",
            "properties": {
              "payrollPeriod": {"type": "string", "description": "Payroll period (YYYY-MM)"},
              "companyCode": {"type": "string", "description": "Company code"},
              "confirmed": {"type": "boolean", "description": "Explicit human confirmation flag"}
            },
            "required": ["payrollPeriod", "companyCode", "confirmed"]
          },
          "mock_response": {
            "runId": "RUN-2024-02",
            "payrollPeriod": "2024-02",
            "status": "Initiated",
            "initiatedAt": "2024-02-01T09:00:00Z",
            "employeeCount": 150
          }
        },
        "create_reimbursement_record": {
          "description": "Creates an expense reimbursement record",
          "input_schema": {
            "type": "object",
            "properties": {
              "employeeId": {"type": "string", "description": "Employee ID"},
              "amount": {"type": "number", "description": "Reimbursement amount"},
              "currency": {"type": "string", "description": "Currency code"},
              "expenseType": {"type": "string", "description": "Expense type code"}
            },
            "required": ["employeeId", "amount", "expenseType"]
          },
          "mock_response": {
            "recordId": "REIMB-2024-001",
            "employeeId": "EMP001",
            "amount": 250.00,
            "currency": "USD",
            "expenseType": "TRAVEL",
            "status": "Created",
            "createdAt": "2024-01-20T10:00:00Z"
          }
        }
      }
    },
    "hana_cloud": {
      "tools": {
        "hana_list_tables": {
          "description": "List all accessible tables and views in the SAP HANA Cloud database. Use this first to discover which business data tables are available before querying.",
          "input_schema": {
            "type": "object",
            "properties": {
              "schema_name": {"type": "string", "description": "Optional schema/owner name to filter tables. Leave empty to list all accessible tables."}
            }
          },
          "mock_response": "SCHEMA_NAME | TABLE_NAME | TYPE\nDBMOCK | PAYROLL_RUNS | TABLE\nDBMOCK | PAYROLL_RUN_ITEMS | TABLE\nDBMOCK | EARMARKED_FUNDS | TABLE\nDBMOCK | STATUTORY_REPORTING_TASKS | TABLE\nDBMOCK | PAYROLL_CACHE | TABLE"
        },
        "hana_describe_table": {
          "description": "Describe the columns, data types, and nullability of a HANA Cloud table. Use this before writing a query to understand the table schema.",
          "input_schema": {
            "type": "object",
            "properties": {
              "table_name": {"type": "string", "description": "Name of the table to describe (e.g. PAYROLL_RUNS)."},
              "schema_name": {"type": "string", "description": "Schema/owner of the table. Leave empty to auto-resolve."}
            },
            "required": ["table_name"]
          },
          "mock_response": "COLUMN_NAME | DATA_TYPE | LENGTH | NULLABLE | DEFAULT\nRUN_ID | NVARCHAR | 64 | FALSE | \nFISCAL_YEAR | NVARCHAR | 4 | FALSE | \nPERIOD | NVARCHAR | 2 | FALSE | \nSTATUS | NVARCHAR | 32 | FALSE | \nEMPLOYEE_COUNT | INTEGER | 10 | TRUE | \nGROSS_PAYROLL | DECIMAL | 15 | TRUE | \nNET_PAYROLL | DECIMAL | 15 | TRUE | \nCURRENCY | NVARCHAR | 3 | TRUE | USD\nCREATED_AT | TIMESTAMP | 27 | FALSE | CURRENT_TIMESTAMP"
        },
        "hana_query": {
          "description": "Execute a read-only SELECT SQL query against the SAP HANA Cloud database. Use hana_list_tables to discover available tables and hana_describe_table to inspect columns first. Results are capped at 200 rows. Write operations are blocked.",
          "input_schema": {
            "type": "object",
            "properties": {
              "sql": {"type": "string", "description": "A read-only SELECT SQL statement to execute against HANA Cloud."}
            },
            "required": ["sql"]
          },
          "mock_response": "RUN_ID | FISCAL_YEAR | PERIOD | STATUS | EMPLOYEE_COUNT | GROSS_PAYROLL | NET_PAYROLL | CURRENCY\n--------------------------------------------------------\nHANA-RUN-2024-01 | 2024 | 01 | Completed | 148 | 740000.00 | 555000.00 | USD\nHANA-RUN-2024-02 | 2024 | 02 | Completed | 150 | 752000.00 | 564000.00 | USD\nHANA-RUN-2024-03 | 2024 | 03 | In Progress | 150 | 0.00 | 0.00 | USD\n(showing up to 200 rows)"
        }
      }
    }
  }
}
