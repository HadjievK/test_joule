{
  "_meta": {
    "sap.ord/ordId": {
      "ordId": "customer.mcpbuilder.sf:apiResource:ECPayrollTimeSheets_MCP:v1"
    },
    "sap.mcpbuilder/translation": {
      "ordId": "customer.mcpbuilder.sf:apiResource:ECPayrollTimeSheets_MCP:v1"
    },
