  },
  "$schema": "https://pages.github.tools.sap/CPA/mcp-protocol/spec-v1/mcp-server-card-spec.schema.json",
  "remotes": [],
  "capabilities": {
    "tools": {},
    "prompts": {}
  },
  "supportedProtocolVersions": [
    "2025-11-25"
  ],
  "name": "sap.mcp/payroll_time_sheet",
  "title": "payroll_time_sheet",
  "version": "1.0.0",
  "description": "MCP server for the payroll_time_sheet service.",
  "tools": [
    {
      "name": "listTimeSheetsPayroll",
      "title": "listTimeSheetsPayroll",
      "description": "Retrieve employee time sheet records for payroll processing",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "top": {
            "type": "integer"
          },
          "skip": {
            "type": "integer"
          },
          "filter": {
            "type": "string",
            "description": "Filter by employee, date range, status"
          },
          "select": {
            "type": "string"
          },
          "orderby": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "d": {
                    "type": "object",
                    "properties": {
                      "results": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "externalCode": {
                              "type": "string"
                            },
                            "userId": {
                              "type": "string",
                              "description": "Employee user ID"
                            },
                            "recordDate": {
                              "type": "string",
                              "format": "date"
                            },
                            "hoursWorked": {
                              "type": "number"
                            },
                            "overtimeHours": {
                              "type": "number"
                            },
                            "status": {
                              "type": "string"
                            },
                            "approvalStatus": {
                              "type": "string"
                            },
                            "costCenter": {
                              "type": "string"
                            },
                            "payrollArea": {
                              "type": "string"
                            },
                            "lastModifiedDate": {
                              "type": "string",
                              "format": "date-time"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "description": "List of time sheets (HTTP 200)"
              }
            ]
          }
        }
      }
    },
    {
      "name": "getTimeSheetPayroll",
      "title": "getTimeSheetPayroll",
      "description": "Retrieve a specific employee time sheet by external code",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "externalcode"
        ],
        "properties": {
          "externalcode": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "object",
                "description": "Employee time sheet (HTTP 200)"
              }
            ]
          }
        }
      }
    },
    {
      "name": "listTimeSheetLogs",
      "title": "listTimeSheetLogs",
      "description": "Retrieve time sheet data collection logs for auditing and verification",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "top": {
            "type": "integer"
          },
          "filter": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "object",
                "description": "Time sheet collection logs (HTTP 200)"
              }
            ]
          }
        }
      }
    }
  ]
