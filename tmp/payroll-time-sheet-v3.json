{
  "openapi": "3.0.0",
  "info": { "title": "Payroll Time Sheet", "version": "1.0.0" },
  "paths": {
    "/EmployeeTimeSheet": {
      "get": {
        "operationId": "listEmployeeTimeSheets",
        "summary": "List employee time sheets",
        "parameters": [
          { "name": "$top", "in": "query", "schema": { "type": "integer" } },
          { "name": "$filter", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of time sheets",
            "content": { "application/json": { "schema": {
              "type": "object",
              "properties": {
                "d": { "type": "object", "properties": {
                  "results": { "type": "array", "items": {
                    "type": "object",
                    "properties": {
                      "externalCode": { "type": "string" },
                      "userId": { "type": "string" },
                      "date": { "type": "string" },
                      "approvalStatus": { "type": "string" },
                      "totalHours": { "type": "number" }
                    }
                  }}
                }}
              }
            }}}
          }
        }
      }
    },
    "/TimeCollector": {
      "get": {
        "operationId": "listTimeCollectors",
        "summary": "List aggregated time collector data",
        "parameters": [
          { "name": "$top", "in": "query", "schema": { "type": "integer" } },
          { "name": "$filter", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Time collector results",
            "content": { "application/json": { "schema": {
              "type": "object",
              "properties": {
                "d": { "type": "object", "properties": {
                  "results": { "type": "array", "items": {
                    "type": "object",
                    "properties": {
                      "externalCode": { "type": "string" },
                      "userId": { "type": "string" },
                      "timeType": { "type": "string" },
                      "totalHours": { "type": "number" }
                    }
                  }}
                }}
              }
            }}}
          }
        }
      }
    },
    "/ExternalTimeRecord": {
      "get": {
        "operationId": "listExternalTimeRecords",
        "summary": "List external time records",
        "parameters": [
          { "name": "$top", "in": "query", "schema": { "type": "integer" } },
          { "name": "$filter", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "External time records", "content": { "application/json": { "schema": { "type": "object" } } } }
        }
      }
    },
    "/ExternalTimeRecord('{externalCode}')": {
      "put": {
        "operationId": "updateExternalTimeRecord",
        "summary": "Update an external time record (correction)",
        "parameters": [
          { "name": "externalCode", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object" } } }
        },
        "responses": {
          "200": { "description": "Updated", "content": { "application/json": { "schema": { "type": "object" } } } }
        }
      }
    }
  }
}
